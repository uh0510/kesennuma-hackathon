# このファイルを .env にコピーして値を入れる（.env は Git に入れない）

# --- web（Vite。VITE_ で始まるものだけ画面から読める。秘密情報は書かない） ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_REGISTRY_ADDRESS=0x...
VITE_AMOY_RPC_URL=https://...

# --- contracts（Hardhat） ---
AMOY_RPC_URL=https://...
DEPLOYER_KEY=0x...
ISSUERS=0x...,0x...

# --- Supabase Edge Functions（supabase secrets set で登録） ---
# REGISTRY_ADDRESS=0x...
# ISSUER_KEYS={"<business_id>":"0x<private key>"}
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
