# このファイルを .env にコピーして値を入れる（.env は Git に入れない）

# --- web（Vite。VITE_ で始まるものだけ画面から読める。秘密情報は書かない） ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_REGISTRY_ADDRESS=0x...
VITE_CHAIN_RPC_URL=https://base-sepolia-rpc.publicnode.com
VITE_EXPLORER_URL=https://sepolia.basescan.org

# --- contracts（Hardhat） ---
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
DEPLOYER_KEY=0x...
ISSUERS=0x...,0x...

# --- Supabase Edge Functions（supabase secrets set で登録） ---
# CHAIN_RPC_URL=https://sepolia.base.org
# REGISTRY_ADDRESS=0x...
# ISSUER_KEYS={"<business_id>":"0x<private key>"}
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
